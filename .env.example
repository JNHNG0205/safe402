# Safe402 environment template
#
# Copy to .env and fill in real values. .env is gitignored; never commit it.
# Every value below is a placeholder. Variable names are proposed Safe402
# names and may be renamed when Phase 2 confirms the exact SDK interfaces.
#
# Secrets marked [SECRET] must never be printed in logs, CLI output, reports,
# HCS messages, contract calldata, or the runner/gateway environment.

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
NODE_ENV=development
SAFE402_API_URL=http://localhost:3000
SAFE402_GATEWAY_URL=http://localhost:3000
# Scoped service token for private API operations (policy registration,
# revocation, private evidence). Separate from payment authorization.
SAFE402_SERVICE_TOKEN=replace-with-random-token                      # [SECRET]
# Authenticated application identity used as subjectId in authorization keys.
SAFE402_SUBJECT_ID=dev-subject

# ---------------------------------------------------------------------------
# Report issuer (signs decision reports; distinct from CRE provenance)
# ---------------------------------------------------------------------------
SAFE402_ISSUER_ID=safe402-dev-issuer
SAFE402_ISSUER_PRIVATE_KEY=replace-with-issuer-signing-key           # [SECRET]
# Comma-separated issuer IDs the CLI and gateway accept.
SAFE402_TRUSTED_ISSUERS=safe402-dev-issuer

# ---------------------------------------------------------------------------
# Persistence
# ---------------------------------------------------------------------------
# SQLite for the single-worker demo, or a PostgreSQL URL.
DATABASE_URL=file:./data/safe402.db

# ---------------------------------------------------------------------------
# Hedera (testnet only)
# ---------------------------------------------------------------------------
HEDERA_NETWORK=testnet
# Operator account that publishes HCS receipts and the service descriptor.
HEDERA_OPERATOR_ID=0.0.000000
HEDERA_OPERATOR_KEY=replace-with-operator-private-key                # [SECRET]
# Submit-key-controlled topics. Leave empty and run the bootstrap script to
# create them, then paste the IDs here.
HEDERA_SERVICE_TOPIC_ID=
HEDERA_RECEIPT_TOPIC_ID=
HEDERA_MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com

# ---------------------------------------------------------------------------
# x402 payment via Blocky402 (server side)
# ---------------------------------------------------------------------------
X402_FACILITATOR_URL=https://replace-with-blocky402-facilitator-url
X402_NETWORK=hedera-testnet
# Recipient account that receives audit payments.
X402_PAY_TO=0.0.000000
# Asset identifier and fixed audit price in the asset's smallest unit.
# Confirm asset, decimals, and units against Blocky402 docs in Phase 2.
X402_ASSET=HBAR
X402_AUDIT_PRICE=100000000
X402_QUOTE_TTL_SECONDS=300

# ---------------------------------------------------------------------------
# x402 payer (client side: CLI, MCP adapter, reference agent)
# ---------------------------------------------------------------------------
# Restricted payment signer. Never passed to the LLM or to submitted tools.
SAFE402_PAYER_ID=0.0.000000
SAFE402_PAYER_KEY=replace-with-payer-private-key                     # [SECRET]
# Spending limit per audit in the same unit as X402_AUDIT_PRICE.
SAFE402_MAX_PAYMENT=100000000
# Recipients the payer will pay. Comma-separated.
SAFE402_TRUSTED_RECIPIENTS=0.0.000000

# ---------------------------------------------------------------------------
# EVM testnet: Safe402AuthorizationRegistry and CRE report delivery
# ---------------------------------------------------------------------------
EVM_CHAIN_ID=11155111
EVM_RPC_URL=https://replace-with-sepolia-rpc-url
# Deployer for the registry contract and manual revocations.
EVM_DEPLOYER_PRIVATE_KEY=replace-with-deployer-private-key           # [SECRET]
# Filled after deployment.
SAFE402_REGISTRY_ADDRESS=0x0000000000000000000000000000000000000000
# Accepted sender for authenticated CRE deliveries (KeystoneForwarder or
# equivalent per current CRE docs). Filled during Phase 2.
CRE_FORWARDER_ADDRESS=0x0000000000000000000000000000000000000000

# ---------------------------------------------------------------------------
# Chainlink CRE
# ---------------------------------------------------------------------------
# SIMULATED or LIVE. Simulation must be labeled; it is not TEE protection.
CRE_EXECUTION_MODE=SIMULATED
# LOCAL, TESTNET, or MAINNET. Where decision reports are delivered.
CRE_REPORT_DELIVERY_MODE=LOCAL
CRE_WORKFLOW_NAME=safe402-policy
CRE_WORKFLOW_ID=
# Allowlisted evidence endpoint the workflow fetches from. Must be reachable
# by the CRE runtime; the workflow never fetches tool-supplied URLs.
CRE_EVIDENCE_BASE_URL=http://localhost:3000/api/v1
# Bearer token the workflow presents to the evidence endpoint.
CRE_EVIDENCE_TOKEN=replace-with-random-token                         # [SECRET]
# Private policy parameter delivered through the CRE secrets path, never in
# workflow source, triggers, logs, or calldata.
CRE_POLICY_SECRET=replace-with-private-policy-parameter              # [SECRET]

# ---------------------------------------------------------------------------
# The Graph
# ---------------------------------------------------------------------------
GRAPH_DEPLOY_KEY=replace-with-subgraph-studio-deploy-key             # [SECRET]
GRAPH_SUBGRAPH_SLUG=safe402
GRAPH_SUBGRAPH_VERSION=v0.0.1
# Hosted query endpoint. Filled after deployment.
GRAPH_QUERY_URL=
GRAPH_API_KEY=                                                       # [SECRET]

# ---------------------------------------------------------------------------
# Runner (isolated behavioral testing)
# ---------------------------------------------------------------------------
RUNNER_IMAGE=safe402-runner:dev
RUNNER_TIMEOUT_MS=120000
RUNNER_MEMORY_LIMIT=1g
RUNNER_PIDS_LIMIT=64
RUNNER_NETWORK=safe402-test
# Controlled endpoints inside the test network.
RUNNER_PRICE_ENDPOINT=http://prices.example.test
RUNNER_SINK_ENDPOINT=http://sink.example.test

# ---------------------------------------------------------------------------
# Optional LLM (explanations and uncertain semantic findings only)
# ---------------------------------------------------------------------------
# Leaving this empty must never produce a canned safe verdict.
ANTHROPIC_API_KEY=                                                   # [SECRET]
ANTHROPIC_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Dashboard
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SAFE402_API_URL=http://localhost:3000
NEXT_PUBLIC_POLL_INTERVAL_MS=2000
